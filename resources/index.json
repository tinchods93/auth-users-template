{
    "table": {
        "usersLicenses": "${self:custom.stackPrefix}-usersLicensesTable"
    },
    "userPool": {
        "name": "${self:custom.stackPrefix}-userPool"
    },
    "userPoolClient": {
        "name": "${self:custom.stackPrefix}-userPoolClient"
    },
    "userPoolSigningUrl": "https://cognito-idp.<region>.amazonaws.com/<userPoolId>/.well-known/jwks.json",
    "functions": {
        "registerUserAction": "${self:custom.stackPrefix}-registerUserAction",
        "loginUserAction": "${self:custom.stackPrefix}-loginUserAction",
        "newPasswordChallengeUserAction": "${self:custom.stackPrefix}-newPasswordChallengeUserAction",
        "forgotPasswordUserAction": "${self:custom.stackPrefix}-forgotPasswordUserAction",
        "confirmForgotPasswordUserAction": "${self:custom.stackPrefix}-confirmForgotPasswordUserAction",
        "getUserProfileUserAction": "${self:custom.stackPrefix}-getUserProfileUserAction",
        "getAllUsersProfileUserAction": "${self:custom.stackPrefix}-getAllUsersProfileUserAction",
        "updateUserAction": "${self:custom.stackPrefix}-updateUserAction",
        "createLicenseAction": "${self:custom.stackPrefix}-createLicenseAction",
        "getLicenseByUserIdAction": "${self:custom.stackPrefix}-getLicenseByUserIdAction",
        "getLicenseAction": "${self:custom.stackPrefix}-getLicenseAction",
        "renewLicenseAction": "${self:custom.stackPrefix}-renewLicenseAction",
        "revokeLicenseAction": "${self:custom.stackPrefix}-revokeLicenseAction",
        "validateSessionTokenAction": "${self:custom.stackPrefix}-validateSessionTokenAction"
    }
}